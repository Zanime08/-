<Window x:Class="WpfApp3.AddBook"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Title="AddBook" Height="450" Width="800">

    <Window.Resources>
        <Style TargetType="Window">
            
        </Style>
    </Window.Resources>
    
    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <TextBlock Grid.Row="0" 
               Text="Новая книга" 
               FontSize="22" 
               FontWeight="Bold" 
               Margin="0,0,0,20"/>

        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            
            <StackPanel Grid.Column="0">
                <Label Content="Название книги:" HorizontalAlignment="Left"/>
                <TextBox x:Name="TitleTextBox" Margin="0,5,0,16"/>

                <Label Content="Автор:" HorizontalAlignment="Left"/>
                <TextBox x:Name="AuthorTextBox" Margin="0,5,0,16"/>

                <Label Content="Жанр:" HorizontalAlignment="Left"/>
                <TextBox x:Name="GenreTextBox" Margin="0,5,0,0"/>
            </StackPanel>

            
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <Label Content="Год издания (1450-2026):" HorizontalAlignment="Left"/>
                <TextBox x:Name="YearTextBox" Margin="0,5,0,16"/>

                <Label Content="Количество экземпляров:" HorizontalAlignment="Left"/>
                <TextBox x:Name="QuantityTextBox" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        
        <StackPanel Grid.Row="2" 
                Orientation="Horizontal" 
                HorizontalAlignment="Right" 
                Margin="0,20,0,0">

            <Button x:Name="SaveButton"
                Content="Сохранить" 
                Width="110" 
                Height="32" 
                IsDefault="True"
                Margin="0,0,12,0"
                Click="SaveButton_Click"/>

            <Button x:Name="CancelButton"
                Content="Отмена" 
                Width="110" 
                Height="32" 
                IsCancel="True"
                Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>

</Window>
