<Window x:Class="WpfApp3.AddBooking"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Title="Бронирование" Height="450" Width="800">
    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Бронирование книги" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Width="350" HorizontalAlignment="Center">
            <Label Content="Выберите читателя (Номер билета - ФИО):" HorizontalAlignment="Left"/>
            <ComboBox x:Name="ReaderComboBox" Margin="0,5,0,20" Height="28"/>
            <Label Content="Выберите книгу:" HorizontalAlignment="Left"/>
            <ComboBox x:Name="BookComboBox" Margin="0,5,0,10" Height="28"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="SaveBookingButton" Content="Подтвердить" Width="120" Height="34" IsDefault="True" Margin="0,0,15,0" Click="SaveBookingButton_Click"/>
            <Button x:Name="CancelBookingButton" Content="Отмена" Width="120" Height="34" IsCancel="True" Click="CancelBookingButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
